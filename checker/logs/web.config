<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <denyUrlSequences>
                    <add sequence="." />
                </denyUrlSequences>
            </requestFiltering>
        </security>
        <httpErrors errorMode="Custom">
            <remove statusCode="403" />
            <error statusCode="403" responseMode="File" path="403.htm" />
        </httpErrors>
    </system.webServer>
</configuration>
